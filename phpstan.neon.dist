parameters:
    level: 5
    reportUnmatchedIgnoredErrors: false

    paths:
        - src
        - tests

    ignoreErrors:
        - '#Attribute class Deprecated does not exist#'
        # The proxies exist to hand a path and a template straight through to the protected methods under test.
        -
            message: '#must be a literal string or built with \$this->buildPath\(\) or RequestPath::build\(\)#'
            path: tests/Api/AbstractApiTest.php
        -
            message: '#Template passed to \$this->buildPath\(\) must be a literal string#'
            path: tests/Api/AbstractApiTest.php

services:
    -
        class: PrivatePackagist\ApiClient\PHPStan\RequestPathRule
        tags:
            - phpstan.rules.rule
